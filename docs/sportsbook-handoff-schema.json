{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prosports.win/schemas/sportsbook-handoff-pick-v2.json",
  "title": "ProSportsWinSportsbookHandoffPick",
  "description": "Normalized pick (v2) for copy/paste and user-directed sportsbook handoff via adapter layer. Pro Sports Win does not place bets or store sportsbook credentials.",
  "type": "object",
  "required": ["schemaVersion", "sport", "league", "market", "player", "event", "selection", "legs", "handoff"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 2 },
    "sport": { "type": "string", "examples": ["MLB", "NFL", "NBA", "NHL", "Soccer"] },
    "league": { "type": "string", "examples": ["MLB", "NFL", "NBA", "NHL", "MLS"] },
    "market": {
      "type": "object",
      "required": ["tabLabel", "canonicalKey", "family", "bookLabel"],
      "properties": {
        "tabLabel": { "type": "string", "description": "In-app market tab label", "examples": ["HR", "Points", "TDs"] },
        "canonicalKey": { "type": "string", "examples": ["mlb.player.home_run", "nba.player.points"] },
        "family": { "type": "string", "examples": ["player_prop"] },
        "bookLabel": { "type": "string", "description": "Human-readable market for copy/search" },
        "bookSearchTerms": { "type": "array", "items": { "type": "string" } }
      }
    },
    "player": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "teamAbbr": { "type": "string" },
        "opponentAbbr": { "type": "string" },
        "position": { "type": "string" }
      }
    },
    "event": {
      "type": "object",
      "properties": {
        "label": { "type": "string", "description": "e.g. NYY @ BOS" },
        "startTimeIso": { "type": "string", "format": "date-time" },
        "startTimeDisplay": { "type": "string", "examples": ["7:10 PM ET"] },
        "venue": { "type": "string" },
        "status": { "type": "string" },
        "eventId": { "type": "string", "description": "Provider event key when known (e.g. MLB gamePk)" }
      }
    },
    "externalIds": {
      "type": "object",
      "properties": {
        "espnAthleteId": { "type": "string" },
        "mlbGamePk": { "type": "string" },
        "providerNote": { "type": "string" }
      }
    },
    "selection": {
      "type": "object",
      "properties": {
        "side": { "type": "string", "examples": ["Over", "Under", "Yes", ""] },
        "line": { "type": ["number", "string", "null"] },
        "lineDisplay": { "type": "string", "examples": ["1+ HR", "Over 22.5 Points"] },
        "statLabel": { "type": "string" }
      }
    },
    "legs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "legIndex": { "type": "integer" },
          "marketKey": { "type": "string" },
          "playerName": { "type": "string" },
          "lineDisplay": { "type": "string" },
          "side": { "type": "string" }
        }
      }
    },
    "odds": {
      "type": "object",
      "properties": {
        "american": { "type": ["integer", "null"] },
        "decimal": { "type": ["number", "null"] },
        "display": { "type": "string" },
        "source": { "type": "string" }
      }
    },
    "sportsbook": {
      "type": ["object", "null"],
      "properties": {
        "id": { "type": "string", "examples": ["draftkings", "fanduel"] },
        "name": { "type": "string" },
        "shortName": { "type": "string" }
      }
    },
    "state": {
      "type": "string",
      "description": "US state code (jurisdiction filter only)",
      "pattern": "^[A-Z]{2}$"
    },
    "handoff": {
      "type": "object",
      "required": ["copyText", "searchQuery", "destinationTier"],
      "properties": {
        "copyText": { "type": "string" },
        "searchQuery": { "type": "string" },
        "destinationTier": {
          "type": "string",
          "enum": ["betslip", "event", "market", "league", "home", "copy_only"]
        },
        "prefilledAvailable": { "type": "boolean" },
        "statusLabel": { "type": "string", "examples": ["Prefilled when available", "Open market", "Copy + search"] },
        "userHint": { "type": "string" },
        "destination": {
          "type": ["object", "null"],
          "properties": {
            "tier": { "type": "string" },
            "kind": { "type": "string" },
            "url": { "type": "string", "format": "uri" },
            "label": { "type": "string" },
            "prefilledAvailable": { "type": "boolean" },
            "userHint": { "type": "string" }
          }
        },
        "deepLinkKind": { "type": "string" },
        "deepLinkUrl": { "type": "string", "format": "uri" },
        "deepLinkLabel": { "type": "string" }
      }
    }
  }
}
